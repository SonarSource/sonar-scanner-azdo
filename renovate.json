{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>SonarSource/renovate-config"
  ],
  "rebaseWhen": "never",
  "packageRules": [
    {
      "description": "Keep frozen task versions on their existing dependencies except for security updates",
      "matchFileNames": [
        "src/common/sonarcloud-v4/**",
        "src/common/sonarqube-v8/**"
      ],
      "enabled": false
    },
    {
      "description": "Do not update dependencies used by integration test fixtures",
      "matchFileNames": [
        "its/**"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
