{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>SonarSource/renovate-config"
  ],
  "rebaseWhen": "never",
  "packageRules": [
    {
      "description": "Do not update dependencies used by integration test fixtures",
      "matchFileNames": [
        "its/**"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
